# Q1. Selection sort and bubble sort
# ============================================================================

def selection_sort(input_list):
    # Check each position in the list
    for i in range(0, len(input_list) - 1):
        # Assume the current position contains the smallest value
        min_index = i

        # Search the unsorted part of the list
        for j in range(i + 1, len(input_list)):
            if input_list[j] < input_list[min_index]:
                min_index = j

        # Swap the smallest value into position i
        if min_index != i:
            input_list[i], input_list[min_index] = \
                input_list[min_index], input_list[i]

    return input_list


def bubble_sort(input_list):
    # Repeat the comparison process for each position
    for i in range(1, len(input_list)):
        # Compare neighboring values from right to left
        for j in range(len(input_list) - 1, i - 1, -1):
            # Swap values if they are out of order
            if input_list[j] < input_list[j - 1]:
                input_list[j], input_list[j - 1] = \
                    input_list[j - 1], input_list[j]

    return input_list


