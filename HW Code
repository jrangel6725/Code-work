# Q5. Reconstruct a sentence
# ============================================================================

def q5(sentence):
    # Split the sentence into separate words
    words = sentence.split()
    word_pairs = []

    # Separate each word from its numerical suffix
    for word in words:
        index = len(word) - 1

        # Move backward while finding the number
        while index >= 0 and word[index].isdigit():
            index -= 1

        text = word[:index + 1]
        position = int(word[index + 1:])

        word_pairs.append([position, text])

    # Sort the words by their numerical positions
    for i in range(1, len(word_pairs)):
        key = word_pairs[i]
        j = i - 1

        while j >= 0 and word_pairs[j][0] > key[0]:
            word_pairs[j + 1] = word_pairs[j]
            j -= 1

        word_pairs[j + 1] = key

    # Rebuild the sentence in the correct order
    result = ""

    for i in range(len(word_pairs)):
        if i > 0:
            result += " "

        result += word_pairs[i][1]

    return result


