# Q4. Largest anagram group
# ============================================================================

def sort_letters(word):
    # Store each character in a list
    letters = []

    for character in word:
        letters.append(character)

    # Sort the characters using insertion sort
    for i in range(1, len(letters)):
        key = letters[i]
        j = i - 1

        while j >= 0 and letters[j] > key:
            letters[j + 1] = letters[j]
            j -= 1

        letters[j + 1] = key

    # Build a string from the sorted characters
    result = ""

    for character in letters:
        result += character

    return result


def anagram(strs):
    groups = {}

    # Group words using their sorted letters as the key
    for word in strs:
        key = sort_letters(word)

        if key not in groups:
            groups[key] = []

        groups[key].append(word)

    # Find the group with the most anagrams
    largest_group = []

    for group in groups.values():
        if len(group) > len(largest_group):
            largest_group = group

    return largest_group


