def q6(strings, parts):
    result = ""

    # Process each string and its corresponding indexes
    for i in range(len(strings)):
        start = parts[i][0]
        end = parts[i][1]

        # The assignment example treats the ending index as inclusive
        for j in range(start, end + 1):
            result += strings[i][j]

    return result


